# Copy to terraform.tfvars only for local operation (it is gitignored).
# GitHub Actions passes TF_VAR_aws_region and TF_VAR_expected_account_id from inputs / repository vars.
project_name         = "sagemaker-llmops"
environment          = "qa"
aws_region           = "ap-south-1"
expected_account_id  = "123456789012" # REPLACE with the qa AWS account
vpc_cidr             = "10.30.0.0/16"
private_subnet_cidrs  = ["10.30.1.0/24", "10.30.2.0/24"]
enable_studio        = true
start_jupyterlab     = false
